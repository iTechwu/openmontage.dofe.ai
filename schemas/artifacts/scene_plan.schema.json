{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/scene_plan",
  "title": "Scene Plan",
  "description": "Ordered scene list produced by the Scene Planner agent.",
  "type": "object",
  "required": ["version", "scenes"],
  "$defs": {
    "identityRecord": {
      "type": "object",
      "description": "Canonical identity bible entry. Scenes reference the stable ID instead of rewriting identity from memory.",
      "required": ["id", "kind", "role", "canonical_anchor", "immutable_traits", "allowed_changes", "reference_tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["character", "vehicle", "product", "prop", "environment"] },
        "role": { "type": "string", "minLength": 1 },
        "canonical_anchor": { "type": "string", "minLength": 1 },
        "immutable_traits": {
          "type": "object",
          "required": ["silhouette", "proportions", "palette", "materials", "signature_features"],
          "properties": {
            "silhouette": { "type": "string", "minLength": 1 },
            "proportions": { "type": "string", "minLength": 1 },
            "palette": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
            "materials": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
            "signature_features": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "allowed_changes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "reference_tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "postproduction_zones": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "temporalBeat": {
      "type": "object",
      "required": ["beat_id", "order", "action", "camera_phase", "completed_end_state"],
      "properties": {
        "beat_id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "duration_hint_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "action": { "type": "string", "minLength": 1 },
        "camera_phase": { "type": "string", "minLength": 1 },
        "sound_phase": { "type": "string", "minLength": 1 },
        "completed_end_state": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dialogueBeat": {
      "type": "object",
      "required": ["order", "speaker_identity_id", "line", "screen_position", "eyeline", "reaction", "pause_after_seconds"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "speaker_identity_id": { "type": "string", "minLength": 1 },
        "line": { "type": "string", "minLength": 1 },
        "screen_position": { "type": "string", "minLength": 1 },
        "eyeline": { "type": "string", "minLength": 1 },
        "reaction": { "type": "string", "minLength": 1 },
        "pause_after_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "continuityHandoffState": {
      "type": "object",
      "description": "Observed state dimensions handed from an accepted parent. Unknown dimensions must be named in continuity_state.uncertainties rather than invented.",
      "required": ["subjects", "props", "environment", "camera", "lighting", "audio", "open_motion"],
      "properties": {
        "subjects": { "type": "string", "minLength": 1 },
        "props": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "camera": { "type": "string", "minLength": 1 },
        "lighting": { "type": "string", "minLength": 1 },
        "audio": { "type": "string", "minLength": 1 },
        "open_motion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "style_playbook": { "type": "string", "description": "Name of the active style playbook" },
    "identity_registry": {
      "type": "array",
      "description": "Project-level identity bible for recurring subjects, products, props, and environments.",
      "items": { "$ref": "#/$defs/identityRecord" },
      "minItems": 1
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "start_seconds", "end_seconds"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["talking_head", "broll", "animation", "character_scene", "diagram", "text_card", "transition", "generated", "screen_recording"]
          },
          "description": { "type": "string" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "script_section_id": { "type": "string" },
          "framing": { "type": "string" },
          "movement": { "type": "string" },
          "transition_in": { "type": "string" },
          "transition_out": { "type": "string" },
          "overlay_notes": { "type": "string" },
          "shot_language": {
            "type": "object",
            "description": "Structured cinematography vocabulary for this scene",
            "properties": {
              "shot_size": {
                "type": "string",
                "enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close_up", "extreme_close_up", "over_shoulder", "insert", "establishing"]
              },
              "camera_movement": {
                "type": "string",
                "enum": ["static", "pan_left", "pan_right", "tilt_up", "tilt_down", "dolly_in", "dolly_out", "tracking_left", "tracking_right", "crane_up", "crane_down", "handheld", "steadicam", "whip_pan", "orbital", "zoom_in", "zoom_out", "rack_focus"]
              },
              "lens_mm": { "type": "integer", "enum": [14, 24, 35, 50, 85, 135, 200] },
              "lighting_key": {
                "type": "string",
                "enum": ["high_key", "low_key", "natural", "golden_hour", "blue_hour", "tungsten_warm", "neon", "silhouette", "rim_lit", "volumetric", "overcast_soft"]
              },
              "depth_of_field": { "type": "string", "enum": ["shallow", "medium", "deep"] },
              "color_temperature": { "type": "string", "enum": ["cool", "neutral", "warm", "mixed"] }
            },
            "additionalProperties": false
          },
          "shot_intent": {
            "type": "string",
            "description": "WHY this shot exists — what purpose it serves in the video"
          },
          "narrative_role": {
            "type": "string",
            "enum": ["establish_context", "introduce_subject", "build_tension", "deliver_payload", "transition", "emotional_beat", "evidence", "comparison", "resolution", "call_to_action"],
            "description": "What role this scene plays in the narrative structure"
          },
          "information_role": {
            "type": "string",
            "description": "What the viewer learns or feels from this scene"
          },
          "hero_moment": {
            "type": "boolean",
            "default": false,
            "description": "True if this is the visual peak of the video — deserves extra attention"
          },
          "generation_contract": {
            "type": "object",
            "description": "Provider-neutral control contract for an AI-generated video scene.",
            "required": ["model_family", "mode", "shot_structure", "felt_intent", "planned_end_state"],
            "properties": {
              "model_family": {
                "type": "string",
                "enum": ["seedance", "generic"],
                "description": "Model family selected by video_selector; seedance enables the structured production contract."
              },
              "mode": {
                "type": "string",
                "enum": ["text_to_video", "image_to_video", "reference_to_video", "first_last_frame", "video_to_video", "edit", "extend"]
              },
              "shot_structure": {
                "type": "string",
                "enum": ["single_take", "phased_single_take", "multi_shot"]
              },
              "continuation_type": {
                "type": "string",
                "enum": ["standalone", "sequence_first_clip", "seamless_continuation", "intentional_next_shot", "bridge_between_known_states", "repair_tail", "reanchor_after_drift"]
              },
              "parent_scene_id": { "type": "string" },
              "felt_intent": { "type": "string", "minLength": 1 },
              "planned_start_state": { "type": "string" },
              "planned_end_state": { "type": "string", "minLength": 1 },
              "identity_anchors": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true,
                "minItems": 1
              },
              "identity_ids": {
                "type": "array",
                "description": "Stable IDs from the project identity_registry used by this scene.",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true,
                "minItems": 1
              },
              "reference_roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["tag", "binding_mode", "role", "transfers", "must_not_transfer"],
                  "properties": {
                    "tag": { "type": "string", "minLength": 1 },
                    "binding_mode": {
                      "type": "string",
                      "enum": ["prompt_token", "input_parameter", "internal_only"],
                      "description": "How this reference reaches the provider. prompt_token is valid only when the selected tool contract declares token syntax."
                    },
                    "role": {
                      "type": "string",
                      "enum": ["identity", "first_frame", "last_frame", "product", "environment", "motion", "camera", "timing", "audio", "continuity_source"]
                    },
                    "transfers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                    "must_not_transfer": { "type": "array", "items": { "type": "string" } }
                  },
                  "additionalProperties": false
                }
              },
              "continuity_locks": { "type": "array", "items": { "type": "string" } },
              "allowed_changes": { "type": "array", "items": { "type": "string" } },
              "completed_beats": { "type": "array", "items": { "type": "string" } },
              "reserved_beats": { "type": "array", "items": { "type": "string" } },
              "prompt_budget": {
                "type": "object",
                "required": ["primary_spend", "economized"],
                "properties": {
                  "primary_spend": { "type": "string", "enum": ["identity", "motion", "scene_density"] },
                  "secondary_spend": { "type": "string", "enum": ["identity", "motion", "scene_density"] },
                  "economized": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                },
                "additionalProperties": false
              },
              "seedance_contract": {
                "type": "object",
                "description": "Structured Seedance directing, prompt-carrier, and continuity state. Internal labels are compiled into filmable prose and never sent verbatim.",
                "required": [
                  "lane",
                  "authoring_state",
                  "primary_action",
                  "shot_design",
                  "temporal_beats",
                  "sound_intent",
                  "prompt_carriers",
                  "exclusions",
                  "continuity_state"
                ],
                "properties": {
                  "lane": { "type": "string", "enum": ["narrative", "utility"] },
                  "authoring_state": {
                    "type": "object",
                    "properties": {
                      "dramatic_function": { "type": "string", "minLength": 1 },
                      "turn": { "type": "string", "minLength": 1 },
                      "pov": { "type": "string", "minLength": 1 },
                      "power_shift": { "type": "string", "minLength": 1 },
                      "objective": { "type": "string", "minLength": 1 },
                      "obstacle_and_tactic": { "type": "string", "minLength": 1 },
                      "subtext": { "type": "string", "minLength": 1 },
                      "suppressed_behavior": { "type": "string", "minLength": 1 },
                      "specific_detail": { "type": "string", "minLength": 1 },
                      "specific_detail_provenance": { "type": "string", "enum": ["source_bound", "authored_choice"] },
                      "specific_detail_source": { "type": ["string", "null"] },
                      "stock_solution_refused": { "type": "string", "minLength": 1 },
                      "value_before": { "type": "string", "minLength": 1 },
                      "value_after": { "type": "string", "minLength": 1 },
                      "utility_intent": { "type": "string", "minLength": 1 },
                      "non_narrative_refusal": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  },
                  "primary_action": { "type": "string", "minLength": 1 },
                  "shot_design": {
                    "type": "object",
                    "required": ["framing", "lens", "blocking", "camera", "camera_axis", "screen_direction", "lighting", "behavior"],
                    "properties": {
                      "framing": { "type": "string", "minLength": 1 },
                      "lens": { "type": "string", "minLength": 1 },
                      "blocking": { "type": "string", "minLength": 1 },
                      "camera": { "type": "string", "minLength": 1 },
                      "camera_axis": { "type": "string", "minLength": 1 },
                      "screen_direction": { "type": "string", "minLength": 1 },
                      "lighting": { "type": "string", "minLength": 1 },
                      "behavior": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  },
                  "temporal_beats": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/temporalBeat" },
                    "minItems": 1
                  },
                  "dialogue_beats": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dialogueBeat" }
                  },
                  "sound_intent": { "type": "string", "minLength": 1 },
                  "prompt_carriers": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "exclusions": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "continuity_state": {
                    "type": "object",
                    "required": ["source_status", "extension_depth", "observation_confidence", "uncertainties"],
                    "properties": {
                      "parent_asset_id": { "type": "string", "minLength": 1 },
                      "source_status": {
                        "type": "string",
                        "enum": ["planned", "canonical_reference", "accepted", "accepted_with_deviation"]
                      },
                      "observed_start_state": { "type": "string", "minLength": 1 },
                      "handoff_state": { "$ref": "#/$defs/continuityHandoffState" },
                      "extension_depth": { "type": "integer", "minimum": 0, "maximum": 3 },
                      "reanchor_required": { "type": "boolean" },
                      "observation_confidence": { "type": "string", "enum": ["high", "medium", "low", "unobserved"] },
                      "uncertainties": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 },
                        "uniqueItems": true
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "source_status": { "enum": ["accepted", "accepted_with_deviation"] }
                          },
                          "required": ["source_status"]
                        },
                        "then": { "required": ["parent_asset_id", "observed_start_state"] }
                      },
                      {
                        "if": {
                          "properties": { "extension_depth": { "const": 3 } },
                          "required": ["extension_depth"]
                        },
                        "then": {
                          "required": ["reanchor_required"],
                          "properties": { "reanchor_required": { "const": true } }
                        }
                      }
                    ],
                    "additionalProperties": false
                  }
                },
                "allOf": [
                  {
                    "if": { "properties": { "lane": { "const": "narrative" } }, "required": ["lane"] },
                    "then": {
                      "properties": {
                        "authoring_state": {
                          "required": [
                            "dramatic_function",
                            "turn",
                            "pov",
                            "power_shift",
                            "objective",
                            "obstacle_and_tactic",
                            "subtext",
                            "suppressed_behavior",
                            "specific_detail",
                            "specific_detail_provenance",
                            "specific_detail_source",
                            "stock_solution_refused",
                            "value_before",
                            "value_after"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": { "properties": { "lane": { "const": "utility" } }, "required": ["lane"] },
                    "then": {
                      "properties": {
                        "authoring_state": {
                          "required": ["utility_intent", "non_narrative_refusal"]
                        }
                      }
                    }
                  }
                ],
                "additionalProperties": false
              },
              "generate_audio": { "type": "boolean" }
            },
            "allOf": [
              {
                "if": { "properties": { "model_family": { "const": "seedance" } }, "required": ["model_family"] },
                "then": {
                  "required": [
                    "model_family",
                    "continuation_type",
                    "planned_start_state",
                    "identity_anchors",
                    "identity_ids",
                    "prompt_budget",
                    "seedance_contract"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "model_family": { "const": "seedance" },
                    "continuation_type": {
                      "enum": [
                        "seamless_continuation",
                        "intentional_next_shot",
                        "bridge_between_known_states",
                        "repair_tail"
                      ]
                    }
                  },
                  "required": ["model_family", "continuation_type"]
                },
                "then": {
                  "properties": {
                    "seedance_contract": {
                      "properties": {
                        "continuity_state": {
                          "required": ["parent_asset_id", "observed_start_state", "handoff_state"],
                          "properties": {
                            "source_status": {
                              "enum": ["accepted", "accepted_with_deviation"]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "model_family": { "const": "seedance" },
                    "continuation_type": { "const": "reanchor_after_drift" }
                  },
                  "required": ["model_family", "continuation_type"]
                },
                "then": {
                  "properties": {
                    "seedance_contract": {
                      "properties": {
                        "continuity_state": {
                          "properties": {
                            "source_status": { "const": "canonical_reference" },
                            "extension_depth": { "const": 0 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "character_actions": {
            "type": "array",
            "description": "Character-specific acting beats for rigged character animation scenes",
            "items": {
              "type": "object",
              "required": ["character_id", "action_sequence"],
              "properties": {
                "character_id": { "type": "string" },
                "emotion": { "type": "string" },
                "action_sequence": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "dialogue": { "type": "string" },
                "target": { "type": "string" },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "texture_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Visual texture descriptors: grain, clean, anamorphic, gritty, ethereal, etc."
          },
          "required_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "description": { "type": "string" },
                "source": { "type": "string", "enum": ["generate", "source", "provided", "record"] }
              },
              "required": ["type", "description", "source"]
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenes": {
            "contains": {
              "type": "object",
              "properties": {
                "generation_contract": {
                  "type": "object",
                  "properties": { "model_family": { "const": "seedance" } },
                  "required": ["model_family"]
                }
              },
              "required": ["generation_contract"]
            }
          }
        },
        "required": ["scenes"]
      },
      "then": { "required": ["identity_registry"] }
    }
  ],
  "additionalProperties": false
}
