{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/asset_manifest",
  "title": "Asset Manifest",
  "description": "Inventory of generated/sourced assets produced by the Asset Generator.",
  "type": "object",
  "required": ["version", "assets"],
  "$defs": {
    "providerPreflight": {
      "type": "object",
      "required": [
        "status",
        "verification_level",
        "tool",
        "provider",
        "tool_version",
        "tool_status",
        "operation",
        "execution_scope",
        "degraded_preflight_approved",
        "input_schema_fingerprint",
        "reference_binding",
        "live_probe",
        "errors",
        "warnings",
        "would_execute"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "degraded", "blocked"] },
        "verification_level": {
          "type": "string",
          "enum": ["declared_tool_contract", "live_provider_contract"]
        },
        "tool": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "tool_status": { "type": "string", "enum": ["available", "degraded", "unavailable"] },
        "operation": { "type": "string", "minLength": 1 },
        "execution_scope": { "type": "string", "enum": ["sample", "batch"] },
        "degraded_preflight_approved": { "type": "boolean" },
        "model_selection": {
          "type": ["object", "null"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "value": {}
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        "input_schema_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "declared_input_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "resolved_input_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "reference_binding": {
          "type": "object",
          "required": ["requested_modes", "supported_modes", "input_fields", "prompt_token_syntax"],
          "properties": {
            "requested_modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "supported_modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "input_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "prompt_token_syntax": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "live_probe": {
          "type": "object",
          "required": ["status", "verification_scope", "warnings", "errors"],
          "properties": {
            "status": { "type": "string", "enum": ["passed", "blocked", "unverified", "not_supported", "not_requested"] },
            "verification_scope": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "errors": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "would_execute": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "lineageCheck": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "not_applicable"] },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "observedContinuityState": {
      "type": "object",
      "description": "Observed state dimensions from the returned take. Unknown dimensions must not be copied from the plan.",
      "required": ["subjects", "props", "environment", "camera", "lighting", "audio", "open_motion"],
      "properties": {
        "subjects": { "type": "string", "minLength": 1 },
        "props": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "camera": { "type": "string", "minLength": 1 },
        "lighting": { "type": "string", "minLength": 1 },
        "audio": { "type": "string", "minLength": 1 },
        "open_motion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "identityObservation": {
      "type": "object",
      "required": ["identity_id", "status", "evidence"],
      "properties": {
        "identity_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["preserved", "deviated", "unverifiable"] },
        "evidence": { "type": "string", "minLength": 1 },
        "deviation": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "deviated" } }, "required": ["status"] },
          "then": { "required": ["deviation"] }
        }
      ],
      "additionalProperties": false
    },
    "promptCompileSpec": {
      "type": "object",
      "description": "Provider-neutral prompt intermediate representation. Provider syntax remains owned by preflight.",
      "required": ["language", "structure", "source_state_policy", "surface_profile", "ordered_sections", "carrier_coverage", "compression_decisions", "endpoint_clause"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "structure": { "type": "string", "enum": ["continuous_take", "multi_shot"] },
        "source_state_policy": { "type": "string", "enum": ["first_clip_planned_opening", "accepted_source_carries_state", "final_frame_carries_static_state", "no_visual_source_describe_observed"] },
        "surface_profile": {
          "type": "object",
          "required": ["name", "verification", "constraints"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "verification": { "type": "string", "enum": ["provider_preflight", "conservative"] },
            "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "ordered_sections": {
          "type": "array",
          "items": { "type": "string", "enum": ["reference_roles", "opening_delta", "identity_locks", "action_beats", "camera", "environment_light", "dialogue_audio", "exclusions", "endpoint"] },
          "minItems": 5,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "action_beats" } },
            { "contains": { "const": "endpoint" } }
          ]
        },
        "reference_emissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tag", "binding_mode", "emitted"],
            "properties": {
              "tag": { "type": "string", "minLength": 1 },
              "binding_mode": { "type": "string", "enum": ["prompt_token", "input_parameter", "internal_only"] },
              "emitted": { "type": "boolean" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "binding_mode": { "enum": ["input_parameter", "internal_only"] } },
                  "required": ["binding_mode"]
                },
                "then": { "properties": { "emitted": { "const": false } } }
              }
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "carrier_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["carrier", "emitted_as"],
            "properties": {
              "carrier": { "type": "string", "minLength": 1 },
              "emitted_as": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "compression_decisions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "endpoint_clause": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "source_tool", "scene_id"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["image", "video", "audio", "narration", "music", "sfx", "diagram", "animation", "code_snippet", "subtitle", "font", "lut"]
          },
          "path": { "type": "string", "description": "Relative path within the pipeline project directory" },
          "source_tool": { "type": "string" },
          "scene_id": { "type": "string" },
          "prompt": { "type": "string", "description": "Generation prompt if AI-generated" },
          "seed": { "type": "integer", "description": "Seed if applicable" },
          "model": { "type": "string", "description": "Model used for generation" },
          "model_family": {
            "type": "string",
            "enum": ["seedance", "generic"],
            "description": "Generation model family used to activate family-specific audit requirements."
          },
          "seedance_contract_version": {
            "type": "string",
            "enum": ["1.0", "2.0"],
            "description": "Version of the Seedance sub-contract. Missing is treated as legacy 1.0; all new or resumed work must use 2.0."
          },
          "cost_usd": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "resolution": { "type": "string" },
          "format": { "type": "string" },
          "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "subtype": { "type": "string", "description": "Sub-classification (e.g. 'background', 'stock', 'generated')" },
          "generation_summary": { "type": "string", "description": "Brief summary of how the asset was generated or sourced" },
          "prompt_review": {
            "type": "object",
            "description": "Generation prompt compilation and preflight audit trail.",
            "required": ["draft", "final", "skills_applied", "continuity_checked", "reference_roles_checked"],
            "properties": {
              "draft": { "type": "string", "minLength": 1 },
              "critique": { "type": "array", "items": { "type": "string" } },
              "final": { "type": "string", "minLength": 1 },
              "skills_applied": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "uniqueItems": true
              },
              "continuity_checked": { "type": "boolean" },
              "reference_roles_checked": { "type": "boolean" },
              "compile_spec": { "$ref": "#/$defs/promptCompileSpec" },
              "provider_preflight": { "$ref": "#/$defs/providerPreflight" }
            },
            "additionalProperties": false
          },
          "take_review": {
            "type": "object",
            "description": "Post-generation review and sequence-canon decision.",
            "required": ["decision", "issues", "accepted_as_canon", "next_action"],
            "properties": {
              "decision": {
                "type": "string",
                "enum": ["keep", "post_fix", "reroll", "rewrite", "reanchor", "reject"]
              },
              "issues": { "type": "array", "items": { "type": "string" } },
              "accepted_as_canon": { "type": "boolean" },
              "canon_status": {
                "type": "string",
                "enum": ["not_accepted", "accepted", "accepted_with_deviation"]
              },
              "observed_end_state": { "type": "string", "minLength": 1 },
              "observed_state": { "$ref": "#/$defs/observedContinuityState" },
              "identity_observations": {
                "type": "array",
                "items": { "$ref": "#/$defs/identityObservation" },
                "minItems": 1,
                "uniqueItems": true
              },
              "parent_asset_id": { "type": "string", "minLength": 1 },
              "extension_depth": { "type": "integer", "minimum": 0, "maximum": 3 },
              "observation_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
              "uncertainties": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "next_action": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "accepted_as_canon": { "const": true } }, "required": ["accepted_as_canon"] },
                "then": {
                  "required": ["observed_end_state"],
                  "properties": {
                    "canon_status": { "enum": ["accepted", "accepted_with_deviation"] }
                  }
                },
                "else": { "properties": { "canon_status": { "const": "not_accepted" } } }
              },
              {
                "if": { "properties": { "decision": { "const": "keep" } }, "required": ["decision"] },
                "then": {
                  "properties": {
                    "accepted_as_canon": { "const": true },
                    "canon_status": { "const": "accepted" }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "decision": { "enum": ["reroll", "rewrite", "reanchor", "reject"] }
                  },
                  "required": ["decision"]
                },
                "then": {
                  "properties": {
                    "accepted_as_canon": { "const": false },
                    "canon_status": { "const": "not_accepted" }
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "provider": { "type": "string", "description": "Provider name (e.g. pixabay, google_imagen)" },
          "license": { "type": "string", "description": "License type (e.g. Pixabay License, CC0)" },
          "original_url": { "type": "string", "description": "Source URL if downloaded from a stock service" },
          "voice_performance": {
            "type": "object",
            "description": "Applied voice-performance contract for narration assets.",
            "properties": {
              "source_section_id": { "type": "string" },
              "delivery_cues_applied": { "type": "boolean" },
              "provider_text_used": { "type": "boolean" },
              "provider_settings": {
                "type": "object",
                "additionalProperties": true
              },
              "sample_approved": { "type": "boolean" },
              "sample_path": { "type": "string" },
              "review_notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": { "properties": { "model_family": { "const": "seedance" } }, "required": ["model_family"] },
            "then": {
              "required": ["provider", "model", "prompt_review", "take_review"],
              "properties": {
                "prompt_review": {
                  "required": ["provider_preflight"],
                  "properties": {
                    "provider_preflight": {
                      "properties": {
                        "status": { "enum": ["passed", "degraded"] },
                        "would_execute": { "const": true }
                      }
                    },
                    "skills_applied": {
                      "allOf": [
                        { "contains": { "const": "seedance-provider" } },
                        { "contains": { "const": "seedance-directing" } },
                        { "contains": { "const": "seedance-continuity" } },
                        { "contains": { "const": "seedance-prompting" } },
                        { "contains": { "const": "seedance-quality" } }
                      ]
                    },
                    "continuity_checked": { "const": true },
                    "reference_roles_checked": { "const": true }
                  }
                },
                "take_review": {
                  "required": [
                    "canon_status",
                    "extension_depth",
                    "observation_confidence",
                    "uncertainties"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model_family": { "const": "seedance" },
                "seedance_contract_version": { "const": "2.0" }
              },
              "required": ["model_family", "seedance_contract_version"]
            },
            "then": {
              "properties": {
                "prompt_review": { "required": ["compile_spec"] },
                "take_review": {
                  "required": ["identity_observations"],
                  "allOf": [
                    {
                      "if": { "properties": { "accepted_as_canon": { "const": true } }, "required": ["accepted_as_canon"] },
                      "then": { "required": ["observed_state"] }
                    }
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "lineage_review": {
      "type": "object",
      "description": "Reviewer-authored cross-asset graph inventory and evidence. The schema validates the record shape, not the truth of the graph claims.",
      "required": ["decision", "reviewed_asset_ids", "roots", "edges", "checks", "findings"],
      "properties": {
        "seedance_contract_version": { "type": "string", "enum": ["1.0", "2.0"] },
        "decision": { "type": "string", "enum": ["pass", "revise", "pass_with_warnings"] },
        "reviewed_asset_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "roots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["parent_asset_id", "child_asset_id", "parent_scene_id", "child_scene_id"],
            "properties": {
              "parent_asset_id": { "type": "string", "minLength": 1 },
              "child_asset_id": { "type": "string", "minLength": 1 },
              "parent_scene_id": { "type": "string", "minLength": 1 },
              "child_scene_id": { "type": "string", "minLength": 1 },
              "relationship": {
                "type": "string",
                "enum": ["seamless_continuation", "intentional_next_shot", "bridge_between_known_states", "repair_tail"]
              }
            },
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "object",
          "required": [
            "unique_ids",
            "parent_exists",
            "parent_precedes_child",
            "acyclic",
            "accepted_parent_authority",
            "observed_state_handoff",
            "extension_depth_and_reanchor",
            "beat_and_identity_continuity",
            "reference_binding_matches_preflight"
          ],
          "properties": {
            "unique_ids": { "$ref": "#/$defs/lineageCheck" },
            "parent_exists": { "$ref": "#/$defs/lineageCheck" },
            "parent_precedes_child": { "$ref": "#/$defs/lineageCheck" },
            "acyclic": { "$ref": "#/$defs/lineageCheck" },
            "accepted_parent_authority": { "$ref": "#/$defs/lineageCheck" },
            "observed_state_handoff": { "$ref": "#/$defs/lineageCheck" },
            "extension_depth_and_reanchor": { "$ref": "#/$defs/lineageCheck" },
            "beat_and_identity_continuity": { "$ref": "#/$defs/lineageCheck" },
            "identity_registry_consistency": { "$ref": "#/$defs/lineageCheck" },
            "prompt_compilation_trace": { "$ref": "#/$defs/lineageCheck" },
            "temporal_structure": { "$ref": "#/$defs/lineageCheck" },
            "reference_binding_matches_preflight": { "$ref": "#/$defs/lineageCheck" }
          },
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "asset_ids", "description", "status"],
            "properties": {
              "severity": { "type": "string", "enum": ["critical", "suggestion", "nitpick", "investigation"] },
              "asset_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "description": { "type": "string", "minLength": 1 },
              "proposed_fix": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["pending", "fixed", "accepted", "deferred"] }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "seedance_contract_version": { "const": "2.0" } },
            "required": ["seedance_contract_version"]
          },
          "then": {
            "properties": {
              "checks": {
                "required": [
                  "identity_registry_consistency",
                  "prompt_compilation_trace",
                  "temporal_structure"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "pass" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "checks": {
                "properties": {
                  "unique_ids": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "parent_exists": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "parent_precedes_child": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "acyclic": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "accepted_parent_authority": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "observed_state_handoff": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "extension_depth_and_reanchor": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "beat_and_identity_continuity": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "identity_registry_consistency": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "prompt_compilation_trace": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "temporal_structure": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } },
                  "reference_binding_matches_preflight": { "properties": { "status": { "enum": ["pass", "not_applicable"] } } }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assets": {
            "contains": {
              "type": "object",
              "properties": { "model_family": { "const": "seedance" } },
              "required": ["model_family"]
            }
          }
        },
        "required": ["assets"]
      },
      "then": { "required": ["lineage_review"] }
    },
    {
      "if": {
        "properties": {
          "assets": {
            "contains": {
              "type": "object",
              "properties": {
                "model_family": { "const": "seedance" },
                "seedance_contract_version": { "const": "2.0" }
              },
              "required": ["model_family", "seedance_contract_version"]
            }
          }
        },
        "required": ["assets"]
      },
      "then": {
        "properties": {
          "lineage_review": {
            "required": ["seedance_contract_version"],
            "properties": { "seedance_contract_version": { "const": "2.0" } }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
