{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/asset_manifest",
  "title": "Asset Manifest",
  "description": "Inventory of generated/sourced assets produced by the Asset Generator.",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "source_tool", "scene_id"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["image", "video", "audio", "narration", "music", "sfx", "diagram", "animation", "code_snippet", "subtitle", "font", "lut"]
          },
          "path": { "type": "string", "description": "Relative path within the pipeline project directory" },
          "source_tool": { "type": "string" },
          "scene_id": { "type": "string" },
          "prompt": { "type": "string", "description": "Generation prompt if AI-generated" },
          "seed": { "type": "integer", "description": "Seed if applicable" },
          "model": { "type": "string", "description": "Model used for generation" },
          "model_family": {
            "type": "string",
            "enum": ["seedance", "generic"],
            "description": "Generation model family used to activate family-specific audit requirements."
          },
          "cost_usd": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "resolution": { "type": "string" },
          "format": { "type": "string" },
          "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "subtype": { "type": "string", "description": "Sub-classification (e.g. 'background', 'stock', 'generated')" },
          "generation_summary": { "type": "string", "description": "Brief summary of how the asset was generated or sourced" },
          "prompt_review": {
            "type": "object",
            "description": "Generation prompt compilation and preflight audit trail.",
            "required": ["draft", "final", "skills_applied", "continuity_checked", "reference_roles_checked"],
            "properties": {
              "draft": { "type": "string", "minLength": 1 },
              "critique": { "type": "array", "items": { "type": "string" } },
              "final": { "type": "string", "minLength": 1 },
              "skills_applied": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "uniqueItems": true
              },
              "continuity_checked": { "type": "boolean" },
              "reference_roles_checked": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "take_review": {
            "type": "object",
            "description": "Post-generation review and sequence-canon decision.",
            "required": ["decision", "issues", "accepted_as_canon", "next_action"],
            "properties": {
              "decision": {
                "type": "string",
                "enum": ["keep", "post_fix", "reroll", "rewrite", "reanchor", "reject"]
              },
              "issues": { "type": "array", "items": { "type": "string" } },
              "accepted_as_canon": { "type": "boolean" },
              "canon_status": {
                "type": "string",
                "enum": ["not_accepted", "accepted", "accepted_with_deviation"]
              },
              "observed_end_state": { "type": "string", "minLength": 1 },
              "parent_asset_id": { "type": "string", "minLength": 1 },
              "extension_depth": { "type": "integer", "minimum": 0, "maximum": 3 },
              "observation_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
              "uncertainties": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "next_action": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "accepted_as_canon": { "const": true } }, "required": ["accepted_as_canon"] },
                "then": {
                  "required": ["observed_end_state"],
                  "properties": {
                    "canon_status": { "enum": ["accepted", "accepted_with_deviation"] }
                  }
                },
                "else": { "properties": { "canon_status": { "const": "not_accepted" } } }
              },
              {
                "if": { "properties": { "decision": { "const": "keep" } }, "required": ["decision"] },
                "then": {
                  "properties": {
                    "accepted_as_canon": { "const": true },
                    "canon_status": { "const": "accepted" }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "decision": { "enum": ["reroll", "rewrite", "reanchor", "reject"] }
                  },
                  "required": ["decision"]
                },
                "then": {
                  "properties": {
                    "accepted_as_canon": { "const": false },
                    "canon_status": { "const": "not_accepted" }
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "provider": { "type": "string", "description": "Provider name (e.g. pixabay, google_imagen)" },
          "license": { "type": "string", "description": "License type (e.g. Pixabay License, CC0)" },
          "original_url": { "type": "string", "description": "Source URL if downloaded from a stock service" },
          "voice_performance": {
            "type": "object",
            "description": "Applied voice-performance contract for narration assets.",
            "properties": {
              "source_section_id": { "type": "string" },
              "delivery_cues_applied": { "type": "boolean" },
              "provider_text_used": { "type": "boolean" },
              "provider_settings": {
                "type": "object",
                "additionalProperties": true
              },
              "sample_approved": { "type": "boolean" },
              "sample_path": { "type": "string" },
              "review_notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": { "properties": { "model_family": { "const": "seedance" } }, "required": ["model_family"] },
            "then": {
              "required": ["provider", "model", "prompt_review", "take_review"],
              "properties": {
                "prompt_review": {
                  "properties": {
                    "skills_applied": {
                      "allOf": [
                        { "contains": { "const": "seedance-provider" } },
                        { "contains": { "const": "seedance-directing" } },
                        { "contains": { "const": "seedance-continuity" } },
                        { "contains": { "const": "seedance-prompting" } },
                        { "contains": { "const": "seedance-quality" } }
                      ]
                    },
                    "continuity_checked": { "const": true },
                    "reference_roles_checked": { "const": true }
                  }
                },
                "take_review": {
                  "required": [
                    "canon_status",
                    "extension_depth",
                    "observation_confidence",
                    "uncertainties"
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
